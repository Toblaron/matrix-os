#!/usr/bin/env bash
# Boot self-test, only active with matrix.selftest=1 on the kernel command line
# (see scripts/selftest-in-container.sh). Reports progress on the serial port.
out=/dev/ttyS0
say() { echo "MATRIX_SELFTEST: $*" > "$out"; }

say "booted ($(systemd-detect-virt 2>/dev/null))"
missing=""
for _ in $(seq 1 300); do
  missing=""
  pgrep -x wayfire >/dev/null || missing+=" wayfire"
  pgrep -x waybar >/dev/null || missing+=" waybar"
  pgrep -f 'python3? .*matrix-hud' >/dev/null || missing+=" matrix-hud"
  [ -z "$missing" ] && break
  sleep 1
done

if [ -n "$missing" ]; then
  say "FAIL: not running:$missing"
  tail -n 60 /home/neo/.local/state/matrix/wayfire.log > "$out" 2>/dev/null
  journalctl -b -p warning -n 60 --no-pager > "$out"
else
  sleep 30 # let the rain fill the screen and the layout windows open
  say "layout windows: $(pgrep -fc -- '--class matrix_')"
  say "failed units: $(systemctl --failed --no-legend | awk '{print $2}' | xargs)"
  log=/home/neo/.local/state/matrix/wayfire.log
  say "pixdecor: $(ls /usr/lib/wayfire/ 2>/dev/null | grep -c pixdecor) plugin(s); in use: $(grep -c pixdecor /home/neo/.config/wayfire.ini 2>/dev/null)"
  say "profile: $(sudo -u neo matrix-hwdetect | tr '
' ' ')"
  say "firewall: nftables=$(systemctl is-active nftables) marker=$([ -e /run/matrix/firewall-strict ] && echo yes || echo no) tables=$(nft list tables 2>&1 | xargs)"
  journalctl -b -u nftables --no-pager | tail -n 6 > "$out"
  say "--- hud.log"
  tail -n 40 /home/neo/.local/state/matrix/hud.log > "$out" 2>/dev/null
  say "--- wayfire views (ipc)"
  sock=$(ls /run/user/1000/wayfire-*.socket 2>/dev/null | head -1)
  [ -n "$sock" ] && timeout 20 sudo -u neo python3 - "$sock" > "$out" 2>&1 <<'PY'
import json, socket, sys
s = socket.socket(socket.AF_UNIX); s.settimeout(15); s.connect(sys.argv[1])
msg = json.dumps({"method": "window-rules/list-views", "data": {}}).encode()
s.sendall(len(msg).to_bytes(4, "little") + msg)
def exact(n):
    b = b""
    while len(b) < n:
        b += s.recv(n - len(b))
    return b
views = json.loads(exact(int.from_bytes(exact(4), "little")))
for v in views if isinstance(views, list) else []:
    g = v.get("geometry", {})
    print(f"view {v.get('id')} {v.get('type')} layer={v.get('layer')} app={v.get('app-id')} "
          f"mapped={v.get('mapped')} {g.get('x')},{g.get('y')} {g.get('width')}x{g.get('height')}")
PY
  say "--- hud / client errors from wayfire.log"
  grep -aiE 'traceback|error|exception|matrix-hud|kitty|gtk|layer' "$log" | grep -v '^EE.*EGL' | tail -n 40 > "$out"
  alive() { pgrep -f 'python3? .*matrix-hud' >/dev/null && pgrep -x wayfire >/dev/null && pgrep -x waybar >/dev/null; }
  alive || { say "FAIL: HUD/compositor died after start"; say DONE; sleep 3; systemctl poweroff; exit 1; }
  say "READY"
  sleep 60
  alive || { say "FAIL: HUD/compositor died later"; say DONE; sleep 3; systemctl poweroff; exit 1; }
  say "READY2"
  dump_hud() {
    say "--- hud.log ($1)"
    tail -n 25 /home/neo/.local/state/matrix/hud.log > "$out" 2>/dev/null
  }
  dump_hud "with pixdecor, +60s"

  # A/B: same session without pixdecor, fresh HUD
  ini=/home/neo/.config/wayfire.ini
  if grep -q '^plugins = .*\bpixdecor\b' "$ini"; then
    sudo -u neo sed -i '/^plugins = /s/\bpixdecor\b/decoration/' "$ini"
    sleep 10 # Wayfire reloads the ini and swaps the decorator
    env_of_bar=$(tr '\0' '\n' < /proc/$(pgrep -x waybar | head -1)/environ | grep -E '^(WAYLAND_DISPLAY|XDG_RUNTIME_DIR|WAYFIRE_SOCKET|MATRIX_[A-Z_]+|WLR_[A-Z_]+|HOME|USER|PATH)=')
    pkill -f 'python3? .*matrix-hud'; sleep 2
    echo "=== restart without pixdecor" | sudo -u neo tee -a /home/neo/.local/state/matrix/hud.log >/dev/null
    sudo -u neo env $env_of_bar setsid matrix-hud >/dev/null 2>&1 &
    sleep 60
    say "READY3"
    dump_hud "without pixdecor, +60s"
  fi
  sleep 10
  say "PASS"
fi
say "DONE"
sleep 3
systemctl poweroff
