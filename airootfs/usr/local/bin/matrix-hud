#!/usr/bin/env python3
"""Matrix OS desktop HUD.

Draws the animated digital-rain wallpaper on the layer-shell BACKGROUND layer
and the glowing system gauges on the BOTTOM layer, so normal windows always
sit above them.

  - rain reacts to the system: faster/brighter with CPU load, flashes red on
    connection loss, firewall drops and "deja vu" (watched files changing)
  - status block, telemetry panel, Sentinels (outbound connections) and the
    recon graph written by matrix-recon
  - workspace / 3D cube state via Wayfire IPC
  - the white rabbit: hops across the screen now and then, click to follow it

Modes (MATRIX_HUD_MODE or ~/.cache/matrix/hud-mode, re-read on SIGUSR1):
  full     rain + all widgets (default)
  monitor  rain + all widgets incl. Sentinels and recon graph pinned
  cinema   rain only
  calm     no rain, minimal widgets (blue pill)

Env:
  MATRIX_RAIN_FPS   frames per second of the rain (default 20, 0 disables)
"""
import signal

# matrix-layout sends SIGUSR1 to switch modes; until the GLib handler is in
# place the default action would kill us, and imports are slow on weak CPUs
signal.signal(signal.SIGUSR1, signal.SIG_IGN)

import json  # noqa: E402
import math  # noqa: E402
import os  # noqa: E402
import random  # noqa: E402
import socket  # noqa: E402
import subprocess
import time
from collections import deque
from pathlib import Path

import cairo
import gi
import psutil

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
from gi.repository import Gdk, Gio, GLib, Gtk, GtkLayerShell  # noqa: E402

FONT = "FiraCode Nerd Font Mono"
GREEN = (0.24, 1.0, 0.45)
DIM = (0.10, 0.55, 0.25)
RED = (1.0, 0.22, 0.18)
PANEL_BG = (0.0, 0.07, 0.03, 0.62)
# cairo's toy text API has no font fallback, so stick to glyphs FiraCode has
GLYPHS = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdeghknpqxz@#$%&*+=<>:;|\\/?"
HISTORY = 60
CACHE = Path.home() / ".cache" / "matrix"
MODE_FILE = CACHE / "hud-mode"
RECON_GRAPH = CACHE / "recon-graph.json"
WATCHED = [
    "/etc/passwd", "/etc/shadow", "/etc/group", "/etc/sudoers", "/etc/hosts",
    "/etc/nftables.conf", str(Path.home() / ".ssh/authorized_keys"),
    str(Path.home() / ".bashrc"), str(Path.home() / ".bash_profile"),
]
RABBIT = [
    r" (\(\ ",
    r" ( -.-)",
    r' o_(")(")',
]


def say(text):
    """Operator voice (no-op unless enabled, see matrix-say)."""
    subprocess.Popen(["matrix-say", text], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def notify(title, body=""):
    subprocess.Popen(["notify-send", "-a", "Matrix", title, body],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


# --------------------------------------------------------------------------- stats
class Stats:
    """Samples system telemetry once a second and keeps short histories."""

    def __init__(self):
        self.cpu = 0.0
        self.cores = []
        self.mem = psutil.virtual_memory()
        self.swap = psutil.swap_memory()
        self.disk = psutil.disk_usage("/")
        self.temp = None
        self.online = False
        self.link = "OFFLINE"
        self.rx_rate = self.tx_rate = 0.0
        self.rx_total = self.tx_total = 0
        self.rx_hist = deque([0.0] * HISTORY, maxlen=HISTORY)
        self.cpu_hist = deque([0.0] * HISTORY, maxlen=HISTORY)
        self.io_hist = deque([0.0] * 24, maxlen=24)
        self.sentinels = []
        self.fw_drops = None
        self.fw_new = 0
        self._tick = 0
        self._net = psutil.net_io_counters()
        self._io = psutil.disk_io_counters()
        self._t = time.monotonic()
        psutil.cpu_percent(percpu=True)
        self.listeners = []
        self.update()

    def update(self):
        now = time.monotonic()
        dt = max(now - self._t, 1e-3)
        self._t = now
        self._tick += 1
        self.cores = psutil.cpu_percent(percpu=True) or [0.0]
        self.cpu = sum(self.cores) / len(self.cores)
        self.cpu_hist.append(self.cpu)
        self.mem = psutil.virtual_memory()
        self.swap = psutil.swap_memory()
        self.disk = psutil.disk_usage("/")

        net = psutil.net_io_counters()
        self.rx_rate = (net.bytes_recv - self._net.bytes_recv) / dt
        self.tx_rate = (net.bytes_sent - self._net.bytes_sent) / dt
        self.rx_total, self.tx_total = net.bytes_recv, net.bytes_sent
        self._net = net
        self.rx_hist.append(self.rx_rate + self.tx_rate)

        io = psutil.disk_io_counters()
        if io and self._io:
            self.io_hist.append(
                (io.read_bytes + io.write_bytes - self._io.read_bytes - self._io.write_bytes) / dt
            )
        self._io = io

        self.temp = None
        try:
            temps = psutil.sensors_temperatures()
            for key in ("k10temp", "coretemp", "zenpower", "cpu_thermal", "acpitz"):
                if temps.get(key):
                    self.temp = temps[key][0].current
                    break
        except (AttributeError, OSError):
            pass

        was_online = self.online
        self.online = has_default_route()
        self.link = link_state(self.online, fw_loaded=self.fw_drops is not None)
        if was_online and not self.online:
            self.emit("offline")

        if self._tick % 2 == 0:
            self.sentinels = outbound_connections()
        if self._tick % 3 == 0:
            drops = firewall_drops()
            if drops is not None and self.fw_drops is not None and drops > self.fw_drops:
                self.fw_new += drops - self.fw_drops
                self.emit("drops")
            self.fw_drops = drops
        return True

    def emit(self, what):
        for fn in self.listeners:
            fn(what)


def has_default_route():
    try:
        with open("/proc/net/route") as f:
            next(f)
            return any(line.split()[1] == "00000000" for line in f)
    except (OSError, IndexError, StopIteration):
        return False


def link_state(online, fw_loaded=False):
    """What the CONNECTION tag claims, backed by what is actually running."""
    if not online:
        return "OFFLINE"
    if any(p.info["name"] == "tor" for p in psutil.process_iter(["name"])):
        return "TOR"
    stats = psutil.net_if_stats()
    if any(n.startswith(("wg", "tun", "proton", "mullvad")) and s.isup for n, s in stats.items()):
        return "VPN"
    if fw_loaded or Path("/run/matrix/firewall-strict").exists():
        return "SECURED"
    return "EXPOSED"


def outbound_connections(limit=7):
    rows = []
    try:
        conns = psutil.net_connections(kind="inet")
    except (psutil.AccessDenied, OSError):
        return rows
    names = {}
    for c in conns:
        if c.status != psutil.CONN_ESTABLISHED or not c.raddr:
            continue
        if c.raddr.ip.startswith(("127.", "::1")):
            continue
        if c.pid not in names:
            try:
                names[c.pid] = psutil.Process(c.pid).name() if c.pid else "?"
            except psutil.Error:
                names[c.pid] = "?"
        rows.append((names[c.pid], f"{c.raddr.ip}:{c.raddr.port}"))
    rows.sort()
    return rows[:limit]


def firewall_drops():
    try:
        cmd = ["nft", "-j", "list", "counter", "inet", "matrix", "dropped"]
        if os.geteuid() != 0:
            cmd = ["sudo", "-n"] + cmd  # NOPASSWD on the live system; skipped silently elsewhere
        out = subprocess.run(cmd,
                             capture_output=True, text=True, timeout=2)
        for item in json.loads(out.stdout).get("nftables", []):
            if "counter" in item:
                return item["counter"]["packets"]
    except (OSError, ValueError, subprocess.SubprocessError):
        pass
    return None


def human(n, suffix="B/s"):
    for unit in ("", "K", "M", "G", "T"):
        if abs(n) < 1024:
            return f"{n:5.1f}{unit}{suffix}"
        n /= 1024
    return f"{n:.1f}P{suffix}"


# --------------------------------------------------------------------------- wayfire ipc
class WayfireIPC:
    """Tracks the active workspace and whether the 3D cube is spinning."""

    def __init__(self, on_change):
        self.on_change = on_change
        self.ws = None  # (x, y, grid_w, grid_h)
        self.cube = False
        self.changed_at = 0.0
        self.path = os.environ.get("WAYFIRE_SOCKET")
        if not self.path:
            return
        try:
            self.refresh()
            self.events = self._connect()
            self._send(self.events, "window-rules/events/watch", {
                "events": ["wset-workspace-changed", "plugin-activation-state-changed",
                           "output-gain-focus"]})
            self._read(self.events)
            GLib.io_add_watch(self.events.fileno(), GLib.IO_IN | GLib.IO_HUP, self._on_event)
        except OSError:
            self.path = None

    def _connect(self):
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(2)
        s.connect(self.path)
        return s

    @staticmethod
    def _send(sock, method, data=None):
        payload = json.dumps({"method": method, "data": data or {}}).encode()
        sock.sendall(len(payload).to_bytes(4, "little") + payload)

    @staticmethod
    def _read(sock):
        def exact(n):
            buf = b""
            while len(buf) < n:
                chunk = sock.recv(n - len(buf))
                if not chunk:
                    raise OSError("wayfire socket closed")
                buf += chunk
            return buf
        return json.loads(exact(int.from_bytes(exact(4), "little")))

    def refresh(self):
        with self._connect() as s:
            self._send(s, "window-rules/get-focused-output")
            reply = self._read(s)
        info = reply.get("info", reply)
        ws = info.get("workspace") or {}
        if "x" in ws:
            self.ws = (ws["x"], ws["y"], ws.get("grid_width", 1), ws.get("grid_height", 1))

    def _on_event(self, _fd, cond):
        if cond & GLib.IO_HUP:
            return False
        try:
            ev = self._read(self.events)
        except (OSError, ValueError):
            return False
        if ev.get("event") == "plugin-activation-state-changed" and ev.get("plugin") == "cube":
            self.cube = bool(ev.get("state"))
        else:
            try:
                self.refresh()
            except (OSError, ValueError):
                pass
        self.changed_at = time.time()
        self.on_change()
        return True

    def label(self):
        if self.cube:
            return "WORKSPACE: 3D CUBE ACTIVE", "ROTATION: MANUAL"
        if self.ws:
            x, y, gw, gh = self.ws
            return f"WORKSPACE: {y * gw + x + 1}/{gw * gh}", f"GRID: {x},{y}"
        return None, None


# --------------------------------------------------------------------------- drawing helpers
def rgba(c, a=1.0):
    return (*c[:3], a)


def glow_stroke(cr, color=GREEN, width=1.5, alpha=1.0):
    """Stroke the current path with a soft bloom underneath."""
    path = cr.copy_path()
    for w, a in ((width * 6, 0.06), (width * 3, 0.12)):
        cr.new_path()
        cr.append_path(path)
        cr.set_source_rgba(*rgba(color, a * alpha))
        cr.set_line_width(w)
        cr.stroke()
    cr.new_path()
    cr.append_path(path)
    cr.set_source_rgba(*rgba(color, alpha))
    cr.set_line_width(width)
    cr.stroke()


def rounded_rect(cr, x, y, w, h, r=8):
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 1.5 * math.pi)
    cr.close_path()


def panel(cr, x, y, w, h, r=8, color=GREEN):
    rounded_rect(cr, x, y, w, h, r)
    cr.set_source_rgba(*PANEL_BG)
    cr.fill_preserve()
    glow_stroke(cr, color=color, width=1.2, alpha=0.85)


def text(cr, s, x, y, size=11, color=GREEN, alpha=1.0, align="left"):
    cr.select_font_face(FONT, cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_NORMAL)
    cr.set_font_size(size)
    if align != "left":
        w = cr.text_extents(s).x_advance
        x -= w if align == "right" else w / 2
    cr.set_source_rgba(*rgba(color, alpha * 0.25))
    for dx, dy in ((-1, 0), (1, 0), (0, -1), (0, 1)):
        cr.move_to(x + dx, y + dy)
        cr.show_text(s)
    cr.set_source_rgba(*rgba(color, alpha))
    cr.move_to(x, y)
    cr.show_text(s)


def ring(cr, cx, cy, r, frac, width=6, segments=0, phase=0.0, color=GREEN):
    """Background track + glowing value arc, optionally broken into segments."""
    cr.new_path()
    cr.set_line_width(width)
    cr.set_source_rgba(*rgba(DIM, 0.35))
    cr.arc(cx, cy, r, 0, 2 * math.pi)
    cr.stroke()
    start = -math.pi / 2 + phase
    end = start + 2 * math.pi * max(0.0, min(frac, 1.0))
    if segments:
        step = 2 * math.pi / segments
        gap = step * 0.25
        a = start
        while a < end - 1e-3:
            cr.new_path()
            cr.arc(cx, cy, r, a, min(a + step - gap, end))
            glow_stroke(cr, color=color, width=width)
            a += step
    elif end > start:
        cr.new_path()
        cr.arc(cx, cy, r, start, end)
        glow_stroke(cr, color=color, width=width)


def grid(cr, x, y, w, h, cols=6, rows=4):
    cr.set_line_width(0.6)
    cr.set_source_rgba(*rgba(GREEN, 0.18))
    for i in range(1, cols):
        cr.move_to(x + w * i / cols, y)
        cr.line_to(x + w * i / cols, y + h)
    for j in range(1, rows):
        cr.move_to(x, y + h * j / rows)
        cr.line_to(x + w, y + h * j / rows)
    cr.stroke()
    cr.rectangle(x, y, w, h)
    glow_stroke(cr, width=1.0, alpha=0.8)


def sparkline(cr, x, y, w, h, values, fill=True):
    vals = list(values)
    peak = max(max(vals), 1e-9)
    n = len(vals)
    cr.new_path()
    for i, v in enumerate(vals):
        px = x + w * i / max(n - 1, 1)
        py = y + h - h * (v / peak) * 0.95
        (cr.move_to if i == 0 else cr.line_to)(px, py)
    path = cr.copy_path()
    if fill:
        cr.line_to(x + w, y + h)
        cr.line_to(x, y + h)
        cr.close_path()
        cr.set_source_rgba(*rgba(GREEN, 0.10))
        cr.fill()
        cr.append_path(path)
    glow_stroke(cr, width=1.1)


def bars(cr, x, y, w, h, values, peak=None, gap=0.35):
    vals = list(values)
    peak = peak or max(max(vals), 1e-9)
    bw = w / max(len(vals), 1)
    for i, v in enumerate(vals):
        bh = h * min(v / peak, 1.0)
        cr.rectangle(x + i * bw + bw * gap / 2, y + h - bh, bw * (1 - gap), bh)
    cr.set_source_rgba(*rgba(GREEN, 0.85))
    cr.fill()


# --------------------------------------------------------------------------- layer windows
def layer_window(monitor, layer, anchors, size=None, margins=None, click_through=True):
    win = Gtk.Window()
    GtkLayerShell.init_for_window(win)
    GtkLayerShell.set_layer(win, layer)
    GtkLayerShell.set_monitor(win, monitor)
    GtkLayerShell.set_namespace(win, "matrix-hud")
    GtkLayerShell.set_keyboard_mode(win, GtkLayerShell.KeyboardMode.NONE)
    GtkLayerShell.set_exclusive_zone(win, -1)
    for edge in anchors:
        GtkLayerShell.set_anchor(win, edge, True)
    for edge, px in (margins or {}).items():
        GtkLayerShell.set_margin(win, edge, px)
    if size:
        win.set_size_request(*size)
    visual = win.get_screen().get_rgba_visual()
    if visual:
        win.set_visual(visual)
    win.set_app_paintable(True)
    if click_through:
        win.connect("realize", lambda w: w.input_shape_combine_region(cairo.Region()))
    return win


class Rain:
    """Digital rain. Columns drop mirrored glyphs; a fade pass leaves the trails.

    Speed and brightness follow CPU load; alert() tints the heads red for a
    moment and spawn_red() drops red columns (one per firewall drop).
    """

    CELL = 16

    def __init__(self, monitor, fps, stats):
        E = GtkLayerShell.Edge
        self.stats = stats
        self.fps = fps
        self.enabled = fps > 0
        self.win = layer_window(
            monitor, GtkLayerShell.Layer.BACKGROUND, (E.TOP, E.BOTTOM, E.LEFT, E.RIGHT)
        )
        self.surface = None
        self.cols = []
        self.alert_until = 0.0
        self.win.connect("draw", self.on_draw)
        self.win.connect("size-allocate", self.on_resize)
        self.win.show_all()
        GLib.timeout_add(int(1000 / max(fps, 1)), self.tick)

    def on_resize(self, _w, alloc):
        if self.surface and (self.surface.get_width(), self.surface.get_height()) == (
            alloc.width,
            alloc.height,
        ):
            return
        self.surface = cairo.ImageSurface(cairo.FORMAT_RGB24, alloc.width, alloc.height)
        cr = cairo.Context(self.surface)
        cr.set_source_rgb(0, 0.012, 0.004)
        cr.paint()
        self.rows = alloc.height // self.CELL + 1
        self.cols = [self.new_column(random.randint(-self.rows, self.rows))
                     for _ in range(alloc.width // self.CELL + 1)]

    def new_column(self, y=None, red=False):
        depth = random.random()
        return {
            "y": -random.randint(0, self.rows) if y is None else y,
            "every": random.choice((1, 1, 2, 2, 3)),  # base frames per cell step
            "bright": 0.35 + 0.65 * depth,
            "size": int(self.CELL * (0.75 + 0.3 * depth)),
            "prev": None,
            "acc": 0.0,
            "red": red,
        }

    def alert(self, seconds=2.5):
        self.alert_until = time.time() + seconds

    def spawn_red(self, n):
        for _ in range(min(n, 12)):
            i = random.randrange(len(self.cols))
            self.cols[i] = self.new_column(y=0, red=True)

    def glyph(self, cr, ch, x, y, size, color):
        cr.save()
        cr.set_font_size(size)
        cr.translate(x + self.CELL, y)
        cr.scale(-1, 1)  # mirrored, like the film
        cr.set_source_rgb(*color)
        cr.move_to(0, 0)
        cr.show_text(ch)
        cr.restore()

    def set_enabled(self, on):
        self.enabled = on and self.fps > 0
        if not self.enabled and self.surface:
            cr = cairo.Context(self.surface)
            cr.set_source_rgb(0, 0.012, 0.004)
            cr.paint()
            self.win.queue_draw()

    def tick(self):
        if not self.surface or not self.enabled:
            return True
        load = self.stats.cpu / 100
        speed = 0.65 + 1.4 * load
        lift = 0.85 + 0.3 * load
        alert = time.time() < self.alert_until
        cr = cairo.Context(self.surface)
        cr.set_source_rgba(0, 0.012, 0.004, 0.055)
        cr.paint()
        cr.select_font_face(FONT, cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        for i, col in enumerate(self.cols):
            col["acc"] += speed / col["every"]
            if col["acc"] < 1:
                continue
            col["acc"] -= 1
            x = i * self.CELL
            b = min(col["bright"] * lift, 1.0)
            red = col["red"] or alert
            if col["prev"] is not None:
                py, pch = col["prev"]
                cr.rectangle(x, py - self.CELL + 3, self.CELL, self.CELL)
                cr.set_source_rgb(0, 0.012, 0.004)
                cr.fill()
                trail = (0.85 * b, 0.12 * b, 0.08 * b) if red else (0.05 * b, 0.85 * b, 0.3 * b)
                self.glyph(cr, pch, x, py, col["size"], trail)
            col["y"] += 1
            y = col["y"] * self.CELL
            if col["y"] > 0:
                ch = random.choice(GLYPHS)
                head = (1.0 * b, 0.55 * b, 0.5 * b) if red else (0.75 * b, 1.0 * b, 0.8 * b)
                self.glyph(cr, ch, x, y, col["size"], head)
                col["prev"] = (y, ch)
            if col["y"] > self.rows + random.randint(0, 20):
                self.cols[i] = self.new_column()
        # random flicker in already-fallen trails
        for _ in range(len(self.cols) // 12):
            x = random.randrange(len(self.cols)) * self.CELL
            y = random.randrange(1, self.rows) * self.CELL
            self.glyph(cr, random.choice(GLYPHS), x, y, self.CELL - 3, (0.02, 0.22, 0.08))
        self.win.queue_draw()
        return True

    def on_draw(self, _w, cr):
        if self.surface:
            cr.set_source_surface(self.surface, 0, 0)
            cr.paint()
        return True


class Widget:
    def __init__(self, monitor, hud, anchors, size, margins, interval=1000):
        self.hud = hud
        self.stats = hud.stats
        self.w, self.h = size
        self.win = layer_window(monitor, GtkLayerShell.Layer.BOTTOM, anchors, size, margins)
        self.win.connect("draw", self._draw)
        self.win.show_all()
        GLib.timeout_add(interval, self._refresh)

    def _refresh(self):
        self.win.queue_draw()
        return True

    def _draw(self, _w, cr):
        cr.set_operator(cairo.OPERATOR_SOURCE)
        cr.set_source_rgba(0, 0, 0, 0)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)
        self.draw(cr)
        return True

    def set_visible(self, on):
        self.win.set_visible(on)


def link_color(link):
    return RED if link in ("OFFLINE", "EXPOSED") else GREEN


class StatusBlock(Widget):
    """Top-right: CPU ring + per-core bar grid, SYS_STATUS / CONNECTION tags."""

    def __init__(self, monitor, hud):
        E = GtkLayerShell.Edge
        super().__init__(monitor, hud, (E.TOP, E.RIGHT), (300, 236), {E.TOP: 50, E.RIGHT: 36})

    def draw(self, cr):
        s = self.stats
        spin = (time.time() % 8) / 8 * 2 * math.pi
        ring(cr, 70, 70, 52, s.cpu / 100, width=7)
        ring(cr, 70, 70, 38, s.mem.percent / 100, width=3, segments=24, phase=spin)
        text(cr, f"{s.cpu:3.0f}%", 70, 75, 14, align="center")
        cr.rectangle(18, 136, 104, 4)
        cr.set_source_rgba(*rgba(DIM, 0.4))
        cr.fill()
        cr.rectangle(18, 136, 104 * s.mem.percent / 100, 4)
        cr.set_source_rgba(*GREEN)
        cr.fill()

        grid(cr, 160, 10, 130, 130)
        bars(cr, 168, 18, 114, 114, s.cores[:16], peak=100)

        dejavu = self.hud.dejavu if time.time() < self.hud.dejavu_until else None
        status = ("DEJA VU", RED) if dejavu else ("ACTIVE", GREEN)
        blink = int(time.time() * 2) % 2
        for x, (k, (v, col)) in ((14, ("SYS_STATUS:", status)),
                                 (156, ("CONNECTION:", (s.link, link_color(s.link))))):
            panel(cr, x, 152, 128, 48, 4, color=col)
            alert = col is RED
            text(cr, k, x + 8, 171, 12, color=col)
            text(cr, v, x + 8, 189, 12, color=col, alpha=0.35 if alert and blink else 1.0)
        footer = f"FW DROPS: {s.fw_drops}" if s.fw_drops is not None else "FW: n/a"
        if dejavu:
            footer = f"CHANGED: {dejavu}"
        text(cr, footer[:40], 14, 222, 10, color=RED if dejavu else GREEN, alpha=0.8)


class TelemetryPanel(Widget):
    """Bottom-centre: network block, memory/disk rings, temp gauge, IO scope."""

    def __init__(self, monitor, hud):
        E = GtkLayerShell.Edge
        super().__init__(monitor, hud, (E.BOTTOM,), (780, 190), {E.BOTTOM: 10})
        self.host = socket.gethostname().upper()

    def draw(self, cr):
        s = self.stats
        left, right = self.hud.ipc.label() if self.hud.ipc else (None, None)
        if left:
            text(cr, left, 6, 16, 14)
            text(cr, right, 774, 16, 14, align="right")
        else:
            up = int(time.time() - psutil.boot_time())
            text(cr, f"HOST: {self.host}", 6, 16, 14)
            text(cr, f"UPTIME: {up // 3600:02d}:{up % 3600 // 60:02d}:{up % 60:02d}",
                 774, 16, 14, align="right")

        panel(cr, 2, 28, 776, 160, 8)
        text(cr, "NET DOWN:", 18, 52, 11)
        text(cr, "NET UP:", 18, 68, 11)
        text(cr, "NET TOTAL:", 18, 84, 11)
        text(cr, human(s.rx_rate), 298, 52, 11, align="right")
        text(cr, human(s.tx_rate), 298, 68, 11, align="right")
        text(cr, human(s.rx_total + s.tx_total, "B"), 298, 84, 11, align="right")
        cr.move_to(18, 152.5)
        cr.line_to(298, 152.5)
        cr.set_source_rgba(*rgba(GREEN, 0.4))
        cr.set_line_width(1)
        cr.stroke()
        sparkline(cr, 18, 96, 280, 56, s.rx_hist)
        text(cr, f"PROFILE: {os.environ.get('MATRIX_PROFILE', 'generic').upper()}", 18, 174, 10)
        text(cr, "CONNECTION: " + s.link, 298, 174, 10, align="right", color=link_color(s.link))

        spin = (time.time() % 12) / 12 * 2 * math.pi
        ring(cr, 385, 108, 62, s.mem.percent / 100, width=6)
        ring(cr, 385, 108, 48, s.disk.percent / 100, width=4, segments=16, phase=-spin)
        ring(cr, 385, 108, 36, s.swap.percent / 100, width=2)
        text(cr, "MEM", 385, 104, 10, align="center")
        text(cr, f"{s.mem.percent:.0f}%", 385, 118, 12, align="center")

        temp = s.temp if s.temp is not None else 0
        ring(cr, 500, 80, 30, temp / 100, width=5)
        text(cr, f"{temp:.0f}°" if s.temp is not None else "--", 500, 85, 12, align="center")
        text(cr, "CPU/TEMP", 500, 128, 9, align="center")
        cr.rectangle(462, 136, 76, 36)
        glow_stroke(cr, width=0.8, alpha=0.6)
        sparkline(cr, 464, 138, 72, 32, s.cpu_hist, fill=False)

        grid(cr, 570, 42, 194, 132, cols=4, rows=4)
        bars(cr, 576, 48, 182, 120, s.io_hist, gap=0.5)
        text(cr, "DISK I/O", 760, 58, 9, align="right", alpha=0.7)


class SentinelsPanel(Widget):
    """Left: live outbound connections (process -> endpoint), plus the recon graph."""

    def __init__(self, monitor, hud):
        E = GtkLayerShell.Edge
        super().__init__(monitor, hud, (E.LEFT,), (340, 470), {E.LEFT: 24}, interval=2000)

    def recon_graph(self):
        try:
            if time.time() - RECON_GRAPH.stat().st_mtime > 900 and self.hud.mode != "monitor":
                return None
            return json.loads(RECON_GRAPH.read_text())
        except (OSError, ValueError):
            return None

    def draw(self, cr):
        rows = self.stats.sentinels
        h = 46 + 18 * max(len(rows), 1)
        panel(cr, 2, 2, 336, h, 8)
        text(cr, "SENTINELS // OUTBOUND", 14, 22, 11)
        if not rows:
            text(cr, "no active connections", 14, 44, 10, alpha=0.6)
        for i, (proc, dest) in enumerate(rows):
            y = 44 + 18 * i
            text(cr, proc[:14], 14, y, 10)
            text(cr, dest[:26], 326, y, 10, align="right", alpha=0.85)

        graph = self.recon_graph()
        if not graph:
            return
        top = h + 14
        panel(cr, 2, top, 336, 466 - top, 8)
        target = graph.get("target", "?")
        nodes = graph.get("nodes", [])[:24]
        text(cr, f"RECON // {target}"[:40], 14, top + 20, 11)
        cx, cy, r = 170, top + 30 + (436 - top) / 2, min(140, (436 - top) / 2 - 10)
        t = time.time() / 30
        for i, name in enumerate(nodes):
            a = 2 * math.pi * i / max(len(nodes), 1) + t
            nx, ny = cx + r * math.cos(a), cy + r * math.sin(a)
            cr.move_to(cx, cy)
            cr.line_to(nx, ny)
            glow_stroke(cr, width=0.6, alpha=0.5)
            cr.arc(nx, ny, 3, 0, 2 * math.pi)
            cr.set_source_rgba(*GREEN)
            cr.fill()
            label = name.replace("." + target, "")[:12]
            text(cr, label, nx + (6 if nx >= cx else -6), ny + 3, 8,
                 align="left" if nx >= cx else "right", alpha=0.8)
        cr.new_path()
        cr.arc(cx, cy, 6, 0, 2 * math.pi)
        glow_stroke(cr, width=2)


class Rabbit:
    """Follow the white rabbit: hops along the bottom edge; click to follow."""

    def __init__(self, monitor):
        E = GtkLayerShell.Edge
        self.monitor = monitor
        self.win = layer_window(monitor, GtkLayerShell.Layer.TOP, (E.BOTTOM, E.LEFT),
                                (110, 64), {E.BOTTOM: 212}, click_through=False)
        self.win.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
        self.win.connect("draw", self.draw)
        self.win.connect("button-press-event", self.follow)
        self.x = -120
        self.hop = 0.0
        GLib.timeout_add_seconds(random.randint(180, 420), self.appear)

    def appear(self):
        self.x = -120
        self.win.show_all()
        GLib.timeout_add(40, self.step)
        return False

    def step(self):
        width = self.monitor.get_geometry().width
        self.x += 6
        self.hop += 0.35
        GtkLayerShell.set_margin(self.win, GtkLayerShell.Edge.LEFT, int(self.x))
        GtkLayerShell.set_margin(self.win, GtkLayerShell.Edge.BOTTOM,
                                 212 + int(abs(math.sin(self.hop)) * 18))
        self.win.queue_draw()
        if self.x > width:
            self.win.hide()
            GLib.timeout_add_seconds(random.randint(420, 1200), self.appear)
            return False
        return True

    def draw(self, _w, cr):
        cr.set_operator(cairo.OPERATOR_SOURCE)
        cr.set_source_rgba(0, 0, 0, 0)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)
        for i, line in enumerate(RABBIT):
            text(cr, line, 4, 18 + i * 16, 14, color=(0.92, 1.0, 0.94))
        return True

    def follow(self, *_):
        self.win.hide()
        self.x = 10 ** 6  # ends the walk on the next step
        subprocess.Popen(["kitty", "--class", "matrix_float", "-e", "matrix-rabbit"])
        return True


# --------------------------------------------------------------------------- app
class Hud:
    def __init__(self):
        self.fps = float(os.environ.get("MATRIX_RAIN_FPS", "20"))
        self.stats = Stats()
        self.stats.listeners.append(self.on_event)
        self.dejavu = None
        self.dejavu_until = 0.0
        self.mode = "full"
        self.rains, self.widgets, self.side = [], [], []
        self.ipc = WayfireIPC(self.on_ipc)
        GLib.timeout_add(1000, self.stats.update)

        display = Gdk.Display.get_default()
        for i in range(display.get_n_monitors()):
            mon = display.get_monitor(i)
            self.rains.append(Rain(mon, self.fps, self.stats))
            if i == 0:
                self.widgets = [StatusBlock(mon, self), TelemetryPanel(mon, self)]
                self.side = [SentinelsPanel(mon, self)]
                self.rabbit = Rabbit(mon)

        self.monitors = [Gio.File.new_for_path(p).monitor_file(Gio.FileMonitorFlags.NONE, None)
                         for p in WATCHED]
        for path, mon in zip(WATCHED, self.monitors):
            mon.connect("changed", self.on_file_changed, path)

        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1, self.load_mode)
        self.load_mode()

    def load_mode(self):
        mode = os.environ.get("MATRIX_HUD_MODE", "full")
        try:
            mode = MODE_FILE.read_text().strip() or mode
        except OSError:
            pass
        self.mode = mode if mode in ("full", "monitor", "cinema", "calm") else "full"
        for r in self.rains:
            r.set_enabled(self.mode != "calm")
        for w in self.widgets:
            w.set_visible(self.mode != "cinema")
        for w in self.side:
            w.set_visible(self.mode in ("full", "monitor"))
        return True

    def on_ipc(self):
        for w in self.widgets:
            w.win.queue_draw()

    def on_event(self, what):
        if what == "offline":
            self.alert(4)
            say("Operator. We lost the connection.")
        elif what == "drops":
            for r in self.rains:
                r.spawn_red(self.stats.fw_new)
            self.stats.fw_new = 0

    def alert(self, seconds=2.5):
        for r in self.rains:
            r.alert(seconds)

    def on_file_changed(self, _mon, _file, _other, event, path):
        if event not in (Gio.FileMonitorEvent.CHANGES_DONE_HINT, Gio.FileMonitorEvent.CREATED,
                         Gio.FileMonitorEvent.DELETED, Gio.FileMonitorEvent.ATTRIBUTE_CHANGED):
            return
        # a black cat walked by twice: something changed what we are watching
        self.dejavu = path
        self.dejavu_until = time.time() + 15
        self.alert(3)
        notify("Deja vu", f"{path} changed")
        say("Deja vu.")


def main():
    CACHE.mkdir(parents=True, exist_ok=True)
    Hud()
    Gtk.main()


if __name__ == "__main__":
    main()
